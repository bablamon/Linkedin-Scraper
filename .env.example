# Copy into Coolify's environment variables. Every value here is a default —
# the service runs correctly with none of them set.

# --- server ---
# Read by the container's own CMD, not by the app's Settings — just the bind port.
PORT=8000
LOG_LEVEL=info
# Leave empty to run open. When set, callers must send `X-API-Key: <value>`.
API_KEY=

# --- rate limiting ---
# Inbound budget, per minute, shared across all callers.
RATE_LIMIT_PER_MIN=10
# Minimum gap between two outbound requests to LinkedIn, in milliseconds.
# This is what actually protects the egress IP — one inbound request can
# escalate through up to MAX_ATTEMPTS outbound hits.
UPSTREAM_MIN_INTERVAL_MS=1500
UPSTREAM_JITTER_MS=700

# --- fetching ---
# curl_cffi TLS/UA persona, comma separated, picked at random per attempt.
# Empty = built-in Chrome set (chrome124,chrome123,chrome120).
# Valid examples: safari17_0, safari15_5, safari15_3, edge101, chrome131.
# An invalid name surfaces as 502 UPSTREAM_ERROR on every request.
IMPERSONATE_TARGETS=
REQUEST_TIMEOUT_S=15
TOTAL_TIMEOUT_S=45
MAX_ATTEMPTS=4

# --- proxies (entirely optional) ---
# Comma or newline separated. Accepts http://, https://, socks5://,
# host:port, and host:port:user:pass.
PROXIES=
# Coolify persistent storage: mount a volume at /data and drop a proxies.txt
# there. Edits are picked up without a redeploy.
PROXY_FILE=/data/proxies.txt
PROXY_COOLDOWN_S=120

# --- cache ---
CACHE_TTL_S=900
CACHE_MAX=512

# --- authenticated session (ONLY needed for GET /contact) ---
# Your own LinkedIn session, taken from a logged-in browser. Contact info is
# never on the public page, so this endpoint needs a real signed-in session.
# LI_AT IS A CREDENTIAL — put it in a Coolify *secret* env var, never in git.
# It only ever returns contact info your own account can already see, and using
# it for automation risks that account, not just the IP. See the README.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Alternative to the two above: a persistent-storage file that overrides them and
# is re-read on change, so you can rotate the cookie without a redeploy. Paste
# the whole `cookie:` header from DevTools or just the two values.
SESSION_FILE=/data/session.txt
# The dash endpoint that returns contact info (verified Sept 2026). Only set this
# if /contact starts returning ENDPOINT_RETIRED — LinkedIn moved the path. `{member}`
# is replaced with the URL-encoded public identifier.
CONTACT_ENDPOINT=https://www.linkedin.com/voyager/api/identity/dash/profiles?q=memberIdentity&memberIdentity={member}
